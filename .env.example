TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
COUPANG_USERNAME=replace-with-coupang-username
COUPANG_PASSWORD=replace-with-coupang-password
COUPANG_LOGIN_URL=https://login.coupang.com/login/login.pang
COUPANG_CART_URL=https://cart.coupang.com/cartView.pang
COUPANG_BROWSER_HEADLESS=true
