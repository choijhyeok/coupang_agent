TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
COUPANG_USERNAME=replace-with-coupang-username
COUPANG_PASSWORD=replace-with-coupang-password
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com
AZURE_OPENAI_API_KEY=replace-with-azure-openai-api-key
AZURE_OPENAI_DEPLOYMENT=replace-with-azure-openai-deployment
AZURE_OPENAI_API_VERSION=2024-12-01-preview
POSTGRES_DSN=postgresql://postgres:postgres@localhost:5432/coupang_cart_agent
COUPANG_SEARCH_ENDPOINT=
COUPANG_LOGIN_URL=https://login.coupang.com/login/login.pang
COUPANG_CART_URL=https://cart.coupang.com/cartView.pang
COUPANG_BROWSER_HEADLESS=true
COUPANG_BROWSER_LAUNCH_MODE=browser_use
COUPANG_CHROME_USER_DATA_DIR=$HOME/Library/Application Support/Google/Chrome
COUPANG_CHROME_PROFILE_DIRECTORY=Profile 1
COUPANG_CHROME_REMOTE_DEBUGGING_PORT=9223
COUPANG_STORAGE_STATE_PATH=.data/coupang-storage-state.json
CART_DB_PATH=.data/cart_results.sqlite3
DEFAULT_CURRENCY=KRW
APP_HOST=127.0.0.1
APP_PORT=8080
